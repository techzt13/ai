# --- NextAuth.js (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-random-string

# In production set this to your deployed URL (e.g. https://example.com).
# For local dev NextAuth auto-detects http://localhost:3000.
# AUTH_URL=http://localhost:3000

# --- GitHub OAuth App (https://github.com/settings/developers) ---
# Homepage URL:       http://localhost:3000
# Callback URL:       http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# --- GitHub Copilot ---
# An OAuth device-flow access token tied to a GitHub account that has an
# ACTIVE Copilot subscription (Pro / Business / Enterprise).
#
# This token is *NOT* the same as the OAuth App token obtained during NextAuth
# login.  The Copilot chat endpoints require a token issued to the official
# Copilot client (client_id = "Iv1.b507a08c87ecfe98"), which is the one used
# by the VS Code Copilot extension.  The easiest ways to obtain one:
#
#   1. Open VS Code with the Copilot extension signed in, then read
#        ~/.config/github-copilot/hosts.json   (macOS/Linux)
#        %AppData%\github-copilot\hosts.json    (Windows)
#      and copy the `oauth_token` value.
#
#   2. Run the GitHub device-flow against client_id Iv1.b507a08c87ecfe98
#      (see README for the exact curl commands).
#
#   3. Use a community proxy such as ericc-ch/copilot-api, which performs the
#      device flow for you and exposes an OpenAI-compatible endpoint.
#
# The token here is exchanged at runtime for a short-lived Copilot bearer
# token by POSTing to https://api.github.com/copilot_internal/v2/token.
#
# ⚠️  Unofficial.  Endpoints/headers may change without notice.  Heavy or
#     abusive use may violate the GitHub Terms of Service.  Personal /
#     educational use on your own subscription only.
COPILOT_OAUTH_TOKEN=ghu_your_copilot_oauth_token_here
